{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "dotenv -- tsx watch --clear-screen=false src/index.ts",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc -p tsconfig.tests.json",
    "clean": "rm -rf dist .turbo node_modules && rm -f tsconfig.tsbuildinfo && rm -f tsconfig.tests.tsbuildinfo"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-rc.109",
    "@effect/platform-node": "4.0.0-rc.109",
    "@my/observability": "workspace:*",
    "@my/persistence": "workspace:*",
    "@my/rest-api": "workspace:*",
    "@my/sync-engine": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@my/typescript-config": "workspace:*",
    "@types/node": "26.0.1",
    "dotenv-cli": "11.0.0",
    "tsx": "4.22.4",
    "typescript": "7.0.2"
  }
}
