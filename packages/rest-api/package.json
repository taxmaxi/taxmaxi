{
  "name": "@my/rest-api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist/**"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc -p tsconfig.tests.json",
    "clean": "rm -rf dist .turbo node_modules && rm -f tsconfig.tsbuildinfo && rm -f tsconfig.tests.tsbuildinfo"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@my/core": "workspace:*",
    "@my/persistence": "workspace:*",
    "@my/sync-engine": "workspace:*",
    "@x402/core": "2.12.0",
    "@x402/evm": "2.12.0",
    "@x402/extensions": "2.12.0",
    "@x402/svm": "2.12.0",
    "effect": "4.0.0-rc.109",
    "stripe": "22.5.0",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@my/typescript-config": "workspace:*",
    "@types/node": "26.0.1",
    "typescript": "7.0.2"
  }
}
